# =============================================================================
# KRX Data Pipeline — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# --- Database (PostgreSQL) ---------------------------------------------------
# Preferred: single DSN string
DB_DSN=postgresql://krx_user:changeme@localhost:5432/krx_data

# Alternative: individual components (used if DB_DSN is empty)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=krx_data
# DB_USER=krx_user
# DB_PASSWORD=changeme

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=plain          # plain | json
# LOG_DIR=                # optional; set to enable rotating file handler

# --- Runtime -----------------------------------------------------------------
RUN_MODE=dev              # dev | prod

# --- Universe sync defaults --------------------------------------------------
UNIVERSE_SOURCE_DEFAULT=fdr    # fdr | pykrx

# --- KRX / pykrx -------------------------------------------------------------
# Required for pykrx endpoints that need an authenticated KRX session.
KRX_ID=
KRX_PW=

# --- OpenDART ---------------------------------------------------------------
# Optional for the current OHLCV pipeline, required for future financial/account ingestion.
OPENDART_API_KEY=
# Comma-separated list of multiple OpenDART API keys. If set, this will be merged with OPENDART_API_KEY.
# OPENDART_API_KEYS=key1,key2,key3

# --- KIS (한국투자증권 오픈API) ----------------------------------------------
# Planned replacement for the KRX MDC scraping path that KRX restricted on
# 2026-08-16 for a terms-of-service violation (automated collection).
# See docs/operations.md "KRX 접근 제한" and
# docs/dev/20260731_raw_features/02_data_expansion_plan/poc/flows_alternatives.md
#
# Covers 5 of the 7 flows metrics (individual/foreign/institutional net buying,
# short-selling volume and value). Foreign holding shares and short-selling
# balance are NOT available here.
#
# Issue the key at https://apiportal.koreainvestment.com (real account required,
# free). Quotation endpoints need only the app key/secret — no account number.
# Rate limit: 20 requests/second per account (real), 2-5/s (paper).
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전 https://openapi.koreainvestment.com:9443 · 모의 https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_TIMEOUT_SECONDS=20.0
# Access tokens last 1 day, reissuing within 6 hours returns the same token, and
# EVERY issuance sends a KakaoTalk notification. Collectors run as ephemeral
# `docker compose run --rm` containers, so the token MUST be cached on a host
# volume or every run reissues (and notifies). Set when the adapter lands.
# KIS_TOKEN_CACHE_PATH=/state/kis_token.json

# --- ECOS -------------------------------------------------------------------
# Bank of Korea ECOS Open API key. Required for common sync --sources ecos.
ECOS_API_KEY=
ECOS_TIMEOUT_SECONDS=20.0

# --- FRED -------------------------------------------------------------------
# Federal Reserve Economic Data API key. Required for common sync --sources fred.
FRED_API_KEY=
FRED_TIMEOUT_SECONDS=20.0

# --- Common feature refresh script ------------------------------------------
# Used by bin/common-features-refresh.sh when set in the shell or scheduler.
# Defaults: daily source lookback=45 days, monthly macro lookback=540 days,
# build lookback=120 days, readiness lookback=60 days, strict coverage=1.0.
# SDC_COMMON_END_DATE=2026-06-11
# SDC_COMMON_DAILY_LOOKBACK_DAYS=45
# SDC_COMMON_MACRO_LOOKBACK_DAYS=540
# SDC_COMMON_BUILD_LOOKBACK_DAYS=120
# SDC_COMMON_READINESS_LOOKBACK_DAYS=60
# SDC_COMMON_RATE_LIMIT_SECONDS=0.2
# SDC_COMMON_SYNC_SOURCES=fdr,fred,ecos,krx
# SDC_COMMON_MACRO_SERIES=macro_cpi,macro_ppi,macro_m2,macro_consumer_sentiment
# SDC_COMMON_REQUIRED_COVERAGE_RATIO=1.0

# --- OpenDART all-years backfill script -------------------------------------
# Used by bin/dart-backfill-all-years.sh when set in the shell or scheduler.
# Defaults: start=2015, end=current year - 1, annual/half/quarterly reports, CFS+OFS.
# SDC_DART_BACKFILL_START_YEAR=2015
# SDC_DART_BACKFILL_END_YEAR=2025
# SDC_DART_BACKFILL_INCLUDE_CURRENT_YEAR=0
# SDC_DART_BACKFILL_REPRT_CODES=11011,11012,11013,11014
# SDC_DART_BACKFILL_FS_DIVS=CFS,OFS
# SDC_DART_BACKFILL_PULL_IMAGE=1

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_SECONDS=0.2
# Take a long rest every N API requests (0 to disable).
LONG_REST_INTERVAL=100
# Duration of each long rest, in seconds.
LONG_REST_SECONDS=10.0

# --- Remote DB sync ---------------------------------------------------------
# Secret metadata file for the remote sj2-server PostgreSQL instance.
REMOTE_DB_INFO_PATH=/Users/whishaw/wss_p/stock_data_collector_secrets/db_info
# Remote sync batch size.
REMOTE_DB_BATCH_SIZE=50000
# Optional override if the host in db_info is not directly reachable.
# REMOTE_DB_HOST_OVERRIDE=
# Optional SSH host (for example, whi@sj2-server) when DB access requires a tunnel.
# REMOTE_DB_SSH_HOST=
# Optional fixed local port for the SSH tunnel.
# REMOTE_DB_SSH_LOCAL_PORT=
# Enable SSH compression for DB tunnel traffic.
REMOTE_DB_SSH_COMPRESSION=false

# --- Timezone (fixed in code, not configurable) ------------------------------
# TIMEZONE is always Asia/Seoul — not exposed as an env var.
