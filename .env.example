# =============================================================================
# KRX Data Pipeline — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# --- Database (PostgreSQL) ---------------------------------------------------
# Preferred: single DSN string
DB_DSN=postgresql://krx_user:changeme@localhost:5432/krx_data

# Alternative: individual components (used if DB_DSN is empty)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=krx_data
# DB_USER=krx_user
# DB_PASSWORD=changeme

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=plain          # plain | json
# LOG_DIR=                # optional; set to enable rotating file handler

# --- Runtime -----------------------------------------------------------------
RUN_MODE=dev              # dev | prod

# --- Universe sync defaults --------------------------------------------------
# krx-openapi is the official endpoint (needs AUTH_KEYS below) and the only one
# of the three that does not reach KRX outside the permitted path. fdr still
# calls data.krx.co.kr twice per invocation just to read max_work_dt, and pykrx
# logs in outright. Prod is still on fdr until AUTH_KEYS is set there (K-5).
UNIVERSE_SOURCE_DEFAULT=fdr    # krx-openapi | fdr | pykrx

# --- KRX / pykrx -------------------------------------------------------------
# Required for pykrx endpoints that need an authenticated KRX session.
KRX_ID=
KRX_PW=
# pykrx logs in to KRX at import, and that login is the collection path KRX
# restricted this host for on 2026-08-16 (이용약관 제10조 제2호) -- it is about
# automated collection, not request rate, so pacing does not make it permitted.
# The paths that needed it now have replacements: `prices backfill` reads Naver
# directly, and universe/market-cap read the Open API. Set this to 1 only for a
# deliberate one-off, e.g. comparing the two sources.
# ALLOW_KRX_SCRAPING=0

# --- OpenDART ---------------------------------------------------------------
# Optional for the current OHLCV pipeline, required for future financial/account ingestion.
OPENDART_API_KEY=
# Comma-separated list of multiple OpenDART API keys. If set, this will be merged with OPENDART_API_KEY.
# OPENDART_API_KEYS=key1,key2,key3

# --- KIS (한국투자증권 오픈API) ----------------------------------------------
# Replacement for the KRX MDC scraping path that KRX restricted on 2026-08-16
# for a terms-of-service violation (automated collection). Used by
# `krx-collector flows sync-kis`.
# See docs/operations.md "KRX 접근 제한" and
# docs/dev/20260731_raw_features/02_data_expansion_plan/poc/flows_alternatives.md
#
# Covers 6 of the 7 flows metrics: individual/foreign/institutional net buying,
# short-selling volume and value, and foreign holding shares. Short-selling
# BALANCE is a KRX-only series and has no substitute here.
#
# Issue the key at https://apiportal.koreainvestment.com (real account required,
# free). Quotation endpoints need only the app key/secret — no account number.
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전 https://openapi.koreainvestment.com:9443 · 모의 https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_TIMEOUT_SECONDS=20.0
# Access tokens last 1 day, reissuing within 6 hours returns the same token, and
# EVERY issuance sends a KakaoTalk notification. Collectors run as ephemeral
# `docker compose run --rm` containers, so the token MUST be cached on a host
# volume or every run reissues (and notifies). Prod compose mounts ./state:/state
# and sets this; locally the default `state/kis_token.json` is gitignored.
# KIS_TOKEN_CACHE_PATH=/state/kis_token.json
# KIS documents 20 requests/second per live account. Measured 2026-08-16, this
# account does not deliver that: 20 consecutive calls came back clean at 1.0/s,
# 1.2/s drew 3 rejections, 1.5/s drew 6, and effective throughput never exceeded
# ~1.1/s at any rate — so a higher setting only converts successes into retries.
# KIS_REQUESTS_PER_SECOND=1.0
# KIS_TOKEN_REFRESH_MARGIN_SECONDS=3600.0

# --- KRX Open API (data-dbg.krx.co.kr) ---------------------------------------
# The official replacement for the pykrx/MDC scraping path — this is where N1
# (daily market cap) and N3 (PIT universe) are headed. Issue keys at
# https://openapi.krx.co.kr; each key carries its own 10,000 requests/day.
# Named AUTH_KEYS because the request header the API expects is AUTH_KEY.
# Comma-separated, same shape as OPENDART_API_KEYS.
#
# A valid key is NOT enough: every endpoint needs its own 이용 신청 and stays
# 401 until that is approved. The two 401 bodies tell you which is missing —
#   "Unauthorized Key"      → the key itself is wrong or missing
#   "Unauthorized API Call" → key is fine, this endpoint is not approved yet
# 16 endpoints were approved on 2026-08-18; the ones the pipeline uses are
# sto/stk_bydd_trd, sto/ksq_bydd_trd, sto/stk_isu_base_info, idx/kospi_dd_trd.
# Read by `prices market-cap-backfill` and `universe backfill-snapshots`, which
# both default to --source krx-openapi.
AUTH_KEYS=
# Ten consecutive unpaced calls drew no rejection on 2026-08-18 and each takes
# 1.3-1.7s anyway, so this cap is a safety rail, not an observed limit.
# KRX_OPENAPI_REQUESTS_PER_SECOND=2.0
# KRX_OPENAPI_TIMEOUT_SECONDS=20.0
# KRX_OPENAPI_BASE_URL=https://data-dbg.krx.co.kr/svc/apis

# --- 공공데이터포털 (data.go.kr) ---------------------------------------------
# getStockPriceInfo — covers the same fields as N1 (mrktTotAmt/lstgStCnt/trPrc)
# and supports beginBasDt/endBasDt range queries, but history starts at
# 2020-01-02, so it covers only ~54% of the 2014-06 target window. It was the
# fallback while KRX approval was pending; now that KRX is open it is kept for
# cross-checking N1 values, not as a collection path.
# Use the *Encoding* key and put it in the URL verbatim: handing it to a query
# encoder turns %2B into %252B and the server receives a different key.
DATAGO_KEY=

# --- ECOS -------------------------------------------------------------------
# Bank of Korea ECOS Open API key. Required for common sync --sources ecos.
ECOS_API_KEY=
ECOS_TIMEOUT_SECONDS=20.0

# --- FRED -------------------------------------------------------------------
# Federal Reserve Economic Data API key. Required for common sync --sources fred.
FRED_API_KEY=
FRED_TIMEOUT_SECONDS=20.0

# --- Common feature refresh script ------------------------------------------
# Used by bin/common-features-refresh.sh when set in the shell or scheduler.
# Defaults: daily source lookback=45 days, monthly macro lookback=540 days,
# build lookback=120 days, readiness lookback=60 days, strict coverage=1.0.
# SDC_COMMON_END_DATE=2026-06-11
# SDC_COMMON_DAILY_LOOKBACK_DAYS=45
# SDC_COMMON_MACRO_LOOKBACK_DAYS=540
# SDC_COMMON_BUILD_LOOKBACK_DAYS=120
# SDC_COMMON_READINESS_LOOKBACK_DAYS=60
# SDC_COMMON_RATE_LIMIT_SECONDS=0.2
# SDC_COMMON_SYNC_SOURCES=fdr,fred,ecos,krx
# SDC_COMMON_MACRO_SERIES=macro_cpi,macro_ppi,macro_m2,macro_consumer_sentiment
# SDC_COMMON_REQUIRED_COVERAGE_RATIO=1.0

# --- OpenDART all-years backfill script -------------------------------------
# Used by bin/dart-backfill-all-years.sh when set in the shell or scheduler.
# Defaults: start=2015, end=current year - 1, annual/half/quarterly reports, CFS+OFS.
# SDC_DART_BACKFILL_START_YEAR=2015
# SDC_DART_BACKFILL_END_YEAR=2025
# SDC_DART_BACKFILL_INCLUDE_CURRENT_YEAR=0
# SDC_DART_BACKFILL_REPRT_CODES=11011,11012,11013,11014
# SDC_DART_BACKFILL_FS_DIVS=CFS,OFS
# SDC_DART_BACKFILL_PULL_IMAGE=1

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_SECONDS=0.2
# Take a long rest every N API requests (0 to disable).
LONG_REST_INTERVAL=100
# Duration of each long rest, in seconds.
LONG_REST_SECONDS=10.0

# --- Remote DB sync ---------------------------------------------------------
# Secret metadata file for the remote sj2-server PostgreSQL instance.
REMOTE_DB_INFO_PATH=/Users/whishaw/wss_p/stock_data_collector_secrets/db_info
# Remote sync batch size.
REMOTE_DB_BATCH_SIZE=50000
# Optional override if the host in db_info is not directly reachable.
# REMOTE_DB_HOST_OVERRIDE=
# Optional SSH host (for example, whi@sj2-server) when DB access requires a tunnel.
# REMOTE_DB_SSH_HOST=
# Optional fixed local port for the SSH tunnel.
# REMOTE_DB_SSH_LOCAL_PORT=
# Enable SSH compression for DB tunnel traffic.
REMOTE_DB_SSH_COMPRESSION=false

# --- Timezone (fixed in code, not configurable) ------------------------------
# TIMEZONE is always Asia/Seoul — not exposed as an env var.
